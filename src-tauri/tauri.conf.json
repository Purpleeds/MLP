{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MLP",
  "version": "0.2.0",
  "identifier": "com.mlp.lyrics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/prepare-redist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MLP Lyrics",
        "width": 420,
        "height": 560,
        "minWidth": 200,
        "minHeight": 48,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Floating synced lyrics for Spotify and YouTube Music",
    "longDescription": "Always-on-top floating lyrics window with word-by-word fill, romanization and display modes, using LRCLIB lyrics.",
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "13.4"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQzUyMUU3REVERjEzMDcKUldRSEU5L2U1eUhGM3JRemVxWkxFeW8zekRxMjRRd2UvUFNQQ0U5MnBVM2xaYnNGY25oSThOUzIK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
